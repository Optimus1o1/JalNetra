generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model catchment_sites {
  id                           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_key                     String                   @unique
  ward_number                  Int
  ward_name                    String
  borough                      String
  site_name                    String
  site_type                    String
  latitude                     Float
  longitude                    Float
  roof_area_sq_m               Float
  open_ground_area_sq_m        Float
  total_catchment_area_sq_m    Float
  runoff_coefficient           Float
  collection_efficiency        Float
  existing_tank_capacity_l     Float
  current_tank_storage_l       Float
  daily_non_potable_demand_l   Float
  soil_infiltration_rate_mm_hr Float
  depth_to_water_table_m       Float
  recharge_suitability         String                   @default("MEDIUM")
  provenance                   Json?                    @default("{}")
  geom                         Unsupported("geometry")?
  created_at                   DateTime?                @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at                   DateTime?                @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  intervention_options         intervention_options[]

  @@index([geom], map: "catchment_sites_geom_gist_idx", type: Gist)
  @@index([recharge_suitability], map: "catchment_sites_recharge_idx")
  @@index([ward_number], map: "catchment_sites_ward_idx")
}

model hooghly_tide_records {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  station_name            String    @default("Outram Ghat")
  recorded_at             DateTime? @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  stage_m_msl             Float
  tide_type               String    @default("SPRING")
  sluice_interlock_active Boolean   @default(false)
  minutes_to_high_tide    Int       @default(0)
  surge_anomaly_m         Float     @default(0.0)
}

model incident_alerts {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alert_code              String    @unique
  ward_id                 String?   @db.Uuid
  severity                String
  title                   String
  description             String
  trigger_mechanism       String
  confidence_score        Float     @default(0.85)
  affected_infrastructure Json?     @default("[]")
  recommended_actions     Json?     @default("[]")
  status                  String    @default("ACTIVE")
  acknowledged_by         String?
  acknowledged_at         DateTime? @db.Timestamptz(6)
  issued_at               DateTime? @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  wards                   wards?    @relation(fields: [ward_id], references: [id], onUpdate: NoAction)
}

model intervention_options {
  id                            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  intervention_key              String           @unique
  site_id                       String?          @db.Uuid
  name                          String
  type                          String
  design_capacity_l             Float
  estimated_cost_inr            Float
  annual_harvest_potential_ml   Float
  annual_runoff_avoided_ml      Float
  priority_score                Float
  implementation_timeline_weeks Int
  status                        String           @default("PROPOSED")
  owner                         String
  provenance                    String           @default("SIMULATED")
  created_at                    DateTime?        @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at                    DateTime?        @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  catchment_sites               catchment_sites? @relation(fields: [site_id], references: [id], onUpdate: NoAction)

  @@index([status], map: "interventions_status_idx")
  @@index([type], map: "interventions_type_idx")
}

model model_records {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model_key            String    @unique
  model_name           String
  version              String
  architecture         String
  brier_score          Float
  crps                 Float
  spatial_iou          Float
  freshness_min        Int
  parameters           String    @default("14.2M")
  inference_latency_ms Int       @default(45)
  status               String    @default("PRODUCTION_ACTIVE")
  last_trained_at      DateTime? @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
}

model persisted_scenarios {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scenario_hash       String    @unique
  scenario_name       String
  ward_number         Int
  rainfall_event_mm   Float
  calculation_version String
  model_version       String
  inputs              Json
  results             Json
  provenance          String    @default("SIMULATED")
  created_at          DateTime? @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  @@index([scenario_hash], map: "persisted_scenarios_hash_idx")
  @@index([calculation_version, model_version], map: "persisted_scenarios_version_idx")
  @@index([ward_number], map: "persisted_scenarios_ward_idx")
}

model rainfall_forecasts {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model_name          String    @default("TCN_Spatiotemporal_Ensemble")
  forecast_run_at     DateTime? @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  horizon             String
  p10_mm              Float
  p50_mm              Float
  p90_mm              Float
  pop_heavy_pct       Float
  intensity_category  String
  return_period_years Float     @default(1.0)
}

model risk_snapshots {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ward_id                String?   @db.Uuid
  computed_at            DateTime? @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  hazard_index           Float
  exposure_index         Float
  vulnerability_index    Float
  composite_risk_score   Float
  ponding_depth_cm       Float
  treeshap_decomposition Json?     @default("[]")
  flood_status           String    @default("NORMAL")
  wards                  wards?    @relation(fields: [ward_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model sensor_nodes {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  node_key             String                   @unique
  name                 String
  type                 String
  ward_id              String?                  @db.Uuid
  latitude             Float
  longitude            Float
  elevation_m          Float                    @default(3.0)
  hardware_spec        String                   @default("ESP32-S3")
  firmware_version     String                   @default("v2.4.1-rc3")
  status               String                   @default("ONLINE")
  battery_pct          Int                      @default(100)
  last_water_level_m   Float?
  last_discharge_cumec Float?
  last_ping_at         DateTime?                @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  geom                 Unsupported("geometry")?
  created_at           DateTime?                @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at           DateTime?                @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  wards                wards?                   @relation(fields: [ward_id], references: [id], onUpdate: NoAction)
  sensor_observations  sensor_observations[]

  @@index([geom], map: "sensor_nodes_geom_gist_idx", type: Gist)
  @@index([status])
  @@index([type])
}

model sensor_observations {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sensor_id               String?       @db.Uuid
  recorded_at             DateTime?     @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  water_level_m           Float?
  discharge_rate_cumec    Float?
  siltation_depth_cm      Float?
  pump_operating_rate_pct Float?
  salinity_ppt            Float?
  quality_flag            String        @default("QC_PASSED")
  raw_payload             Json?
  provenance              String        @default("MEASURED")
  sensor_nodes            sensor_nodes? @relation(fields: [sensor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([quality_flag], map: "sensor_obs_quality_idx")
  @@index([sensor_id, recorded_at(sort: Desc)], map: "sensor_obs_sensor_recorded_idx")
}

model simulation_runs {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scenario_name        String
  created_by           String    @default("OPERATOR_CONSOLE")
  inputs               Json
  outcomes             Json
  dispatched_resources Json?
  created_at           DateTime? @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model wards {
  id                           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ward_number                  Int                      @unique
  ward_name                    String
  borough                      String
  area_sq_km                   Float
  population                   Int
  elevation_baseline_m         Float
  imperviousness_pct           Float
  base_drainage_capacity_cumec Float
  critical_infrastructure      Json?                    @default("[]")
  geometry                     Json?
  geom                         Unsupported("geometry")?
  created_at                   DateTime?                @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at                   DateTime?                @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  incident_alerts              incident_alerts[]
  risk_snapshots               risk_snapshots[]
  sensor_nodes                 sensor_nodes[]

  @@index([geom], map: "wards_geom_gist_idx", type: Gist)
  @@index([ward_number])
}
