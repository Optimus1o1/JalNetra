generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LandUseType {
  RESIDENTIAL
  COMMERCIAL
  OPEN_SPACE
  INDUSTRIAL
}

enum InterventionType {
  MODULAR_CISTERN
  PERMEABLE_PAVEMENT
  BIOSWALE_CORRIDOR
  AQUIFER_INJECTION_WELL
  RETENTION_POND
}

enum DrainageCongestion {
  NORMAL
  ELEVATED
  CRITICAL
}

enum RechargeSuitability {
  HIGHLY_SUITABLE
  MODERATE
  MARGINAL
  UNSUITABLE
}

model CatchmentSite {
  id                 String       @id
  name               String
  ward               Int
  areaHectares       Float
  runoffCoefficient  Float        // C in Q = C * I * A
  existingStorageML  Float
  plannedStorageML   Float
  landUse            LandUseType
  geometry           Json?        // GeoJSON polygon boundary
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([ward])
  @@map("catchment_sites")
}

model InterventionOption {
  id                     String           @id
  siteId                 String
  ward                   Int
  interventionType       InterventionType
  estimatedCostLakhs     Float
  capturePotentialML     Float
  drainageReliefPct      Float
  costEffectivenessRatio Float            // ML per Lakh INR
  implementationMonths   Int
  spatialSuitability     Float            // 0 - 1 score
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([ward])
  @@index([costEffectivenessRatio])
  @@map("intervention_options")
}

model PersistedScenario {
  id                String   @id @default(uuid())
  scenarioHash      String   @unique
  rainfallMm        Float
  storageCapacityML Float
  dailyDemandML     Float
  resultPayload     Json
  accessCount       Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([rainfallMm, storageCapacityML, dailyDemandML])
  @@map("persisted_scenarios")
}
