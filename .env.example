# Database Connection (PostgreSQL 15+ with PostGIS extension)
DATABASE_URL="postgresql://jalnetra_app:<PASSWORD>@<HOST>:5432/postgres"

# Application Port & Host
PORT=3001
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Upstream Satellite & Climate API Feeds (Optional for production live hooks)
# NASA Earthdata / GPM IMERG Access Token
NASA_EARTHDATA_TOKEN=""

# Copernicus Data Space Ecosystem Credentials
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""

# NOAA Physical Sciences Laboratory / Climate Prediction Center
NOAA_CPC_API_ENDPOINT="https://psl.noaa.gov/data/correlation/rean_indices.json"

# Local IoT MQTT Broker (ESP32 Station Ingestion)
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_INGESTION_TOPIC="jalnetra/pilot/kmc/sensors/+"
